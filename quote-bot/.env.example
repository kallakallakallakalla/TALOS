# copy to .env and fill in
FIVEU_API_KEY=your-team-key
FIVEU_BASE_URL=https://api.start-hack.5u.ai

# LLM fallback via 5U gateway (checked against GET /v1/gateway/models at startup)
LLM_MODEL=gpt-4.1-nano
LLM_MAX_CHARS=4000

POLL_INTERVAL_S=3
DB_PATH=quote_bot.sqlite3

# refresh intervals (s)
PORTS_REFRESH_S=300
BRACKETS_TTL_S=300

# quote window: retries stop SAFETY_MARGIN_S before QUOTE_WINDOW_S after mail arrival
QUOTE_WINDOW_S=360
SAFETY_MARGIN_S=60

RATE_WORKERS=8
HTTP_TIMEOUT_S=15

# send quote back to customer automatically (same as --reply)
AUTO_REPLY=0
REPLY_SIGNATURE=Air Freight Desk
CARRIER_LIST=start-kit/carrier-list.csv

# pickup (pre-carriage): postcode zone -> airport, ask truckers, wait for bids
PICKUP_ZONES=start-kit/pickup_zones.csv
PICKUP_WAIT_S=150
PICKUP_MAX_TRUCKERS=5

# every incoming/outgoing mail appended to MAIL_LOG_DIR/YYMMDD_mail_incoming.txt / _outgoing.txt
MAIL_LOG_DIR=mail_logs

# LLM rewrites every outgoing mail in natural language (facts checked, template fallback). Costs tokens.
HUMANIZE=1
