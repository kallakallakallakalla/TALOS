# Langfuse Configuration
LANGFUSE_ENABLED=true
LANGFUSE_PUBLIC_KEY=pk-lf-...
LANGFUSE_SECRET_KEY=sk-lf-...
LANGFUSE_HOST=https://cloud.langfuse.com
# Optional: Name des Prompts im Langfuse Prompt Management (Fallback auf lokalen Prompt wenn leer/nicht gefunden)
LANGFUSE_PROMPT_NAME=router-classification

# Decision API (OpenAI-kompatibel, z.B. gpt-6-luna)
DECISION_API_KEY=sk-...
DECISION_API_BASE_URL=https://api.openai.com/v1
DECISION_MODEL=gpt-6-luna
# DECISION_TEMPERATURE=1.0

# Input API (leer lassen für Placeholder-Modus)
INPUT_API_URL=
INPUT_API_TOKEN=
INPUT_API_TIMEOUT_SECONDS=10.0

# Hackloop Mailbox API & Background Poller
HACKLOOP_BASE_URL=https://api.start-hack.5u.ai
HACKLOOP_API_KEY=
HACKLOOP_MAILBOX=talos@hackloop.mail
MAILBOX_POLL_ENABLED=true
MAILBOX_POLL_INTERVAL_SECONDS=10.0
MAILBOX_POLL_LIMIT=100
MAILBOX_TIMEOUT_SECONDS=10.0

# SQLite Persistence (Cursor & verarbeitete Mails)
SQLITE_DB_PATH=data/router.db
