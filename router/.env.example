# Langfuse Configuration
LANGFUSE_ENABLED=true
LANGFUSE_PUBLIC_KEY=pk-lf-...
LANGFUSE_SECRET_KEY=sk-lf-...
LANGFUSE_HOST=https://cloud.langfuse.com
# Classifier prompt name in Langfuse Prompt Management (local fallback: prompts/<name>.md)
LANGFUSE_PROMPT_NAME=router-classification
# Prompt label the router reads: production (default) or staging
PROMPT_LABEL=production

# Decision API (OpenAI-kompatibel, z.B. gpt-6-luna)
DECISION_API_KEY=sk-...
DECISION_API_BASE_URL=https://api.openai.com/v1
DECISION_MODEL=gpt-6-luna
EXTRACT_MODEL=gpt-6-luna
COMPOSE_MODEL=gpt-6-luna
# Reasoning tokens are billed: none | low | medium | high (empty = model default)
DECISION_REASONING_EFFORT=none
EXTRACT_REASONING_EFFORT=low
COMPOSE_REASONING_EFFORT=none
# DECISION_TEMPERATURE=1.0

# Input API (leer lassen für Placeholder-Modus)
INPUT_API_URL=
INPUT_API_TOKEN=
INPUT_API_TIMEOUT_SECONDS=10.0

# Hackloop Mailbox API & Background Poller
HACKLOOP_BASE_URL=https://api.start-hack.5u.ai
HACKLOOP_API_KEY=
HACKLOOP_MAILBOX=talos@hackloop.mail
MAILBOX_POLL_ENABLED=true
MAILBOX_POLL_INTERVAL_SECONDS=2.0
MAILBOX_POLL_LIMIT=100
MAILBOX_TIMEOUT_SECONDS=10.0

# SQLite Persistence (Cursor & verarbeitete Mails)
SQLITE_DB_PATH=data/router.db

# Quote workflow (docs/workflow.md section 9)
# false = dry run: mails are composed and stored, nothing is sent and nothing is booked.
# Set to true only at cutover, when the old process has been stopped (docs/workflow.md section 12).
SEND_ENABLED=false
MAIL_SIGNATURE=Alex, TALOS Air Freight
MARGIN_EUR=0.0
TRUCKER_WAIT_SECONDS=60
TRUCKER_REASONING_EFFORT=none
FALLBACK_TRUCK_EUR_PER_KG=0.28
BOOKING_REMINDER_SECONDS=600
MAX_CLARIFICATIONS=3
MAX_BOOKING_ATTEMPTS=3
MAX_MESSAGE_ATTEMPTS=3
MAX_ANSWERS=3
START_KIT_DIR=../data/start-kit
TARIFFS_PATH=../data/tariffs.json
PORTAL_RATE_LIMIT_PER_MINUTE=10

# OpenAI key for tests, evals and replays (scripts/eval_prompts.py, replay.py, ...).
# Used directly against api.openai.com. NEVER register it at the challenge gateway:
# gateway traffic is scored as production LLM cost.
EVALUATION_KEY=
EVALUATION_API_BASE_URL=https://api.openai.com/v1

# TEST_MODE=true: the router runs as a test. Nothing is sent or booked, LLM calls use
# EVALUATION_KEY directly (not the scored gateway), shipments go to data/test.db, and portal
# reads are throttled to 3 per minute. Leave false (or remove) for production.
TEST_MODE=false
